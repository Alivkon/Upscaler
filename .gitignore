# Dependencies
node_modules/

# Secrets and local configuration
.env
.env.local
.env.*.local
!.env.example

# Изображения: каталоги в репозитории есть, содержимое — нет.
# Сервер создаёт эти файлы во время работы, а сама коллекция живёт
# на сервере. Git хранит то, что написал человек.
images/*/*
!images/*/.gitkeep

# Список работ на витрине — тоже состояние работающего сервера.
images/gallery.json

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test and build artefacts
coverage/
dist/
build/
.cache/

# Operating system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
# Отрисованные плашки: в репозитории живёт скрипт, а не его результат.
# `scripts/render-plates.mjs` собирает их заново за несколько секунд.
images/plates/*
!images/plates/.gitkeep
