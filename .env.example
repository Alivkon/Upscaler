# Увеличение на своей модели, но на чужой видеокарте: обработчик лежит
# в `service/upscale_modal.py` и выкладывается отдельно от сайта командой
# `modal deploy service/upscale_modal.py`. Она же напечатает адрес.
#
# Ключ и секрет — пара «proxy auth token», заводится один раз в панели Modal
# (Settings → Proxy Auth Tokens). Проверяются они на краю, до контейнера:
# открытый адрес, который кто-то нашёл, — это счёт за холодные старты ради
# чужих запросов. Без любой из трёх переменных приёмка отвечает 503, а витрина
# работает целиком.
UPSCALE_URL=https://your-workspace--upscale-upscaler-upscale.modal.run
UPSCALE_KEY=wk-replace_with_your_modal_proxy_auth_key
UPSCALE_SECRET=ws-replace_with_your_modal_proxy_auth_secret

# Нужен не сайту, а исследовательским скриптам в `scripts/research/`: сравнения
# с платным Topaz идут через Replicate. Сам сервер с 24.08 туда не ходит.
REPLICATE_API_TOKEN=r8_replace_with_your_replicate_api_token
PORT=3000
HOST=0.0.0.0

# Есть ли перед сервером обратный прокси. Счётчик вызовов считает по адресу
# посетителя, а за прокси адрес у всех один — прокси. `1` — один прокси
# впереди, `loopback` — прокси на этой же машине. Пусто (умолчание) — прокси
# нет; включать наугад нельзя, иначе `X-Forwarded-For` подделает кто угодно.
# `true` понимается как `1`; на непонятное значение сервер не стартует
# и называет эту переменную.
# TRUST_PROXY=1

# Адрес сайта. Из него строятся canonical, og:url, карта сайта и ссылка
# на условия в разметке. Умолчание — боевой домен; для местной работы
# раскомментируйте строку ниже, иначе локальные страницы будут называть
# своим адресом tessarum.com.
# SITE_ORIGIN=http://127.0.0.1:3000
