# Увеличение на своей модели, но на чужой видеокарте: обработчик лежит
# в `service/upscale_modal.py` и выкладывается отдельно от сайта командой
# `modal deploy service/upscale_modal.py`. Она же напечатает адрес.
#
# Ключ и секрет — пара «proxy auth token», заводится один раз в панели Modal
# (Settings → Proxy Auth Tokens). Проверяются они на краю, до контейнера:
# открытый адрес, который кто-то нашёл, — это счёт за холодные старты ради
# чужих запросов. Без любой из трёх переменных приёмка отвечает 503, а витрина
# работает целиком.
UPSCALE_URL=https://your-workspace--upscale-upscaler-upscale.modal.run
UPSCALE_KEY=wk-replace_with_your_modal_proxy_auth_key
UPSCALE_SECRET=ws-replace_with_your_modal_proxy_auth_secret

# Нужен не сайту, а исследовательским скриптам в `scripts/research/`: сравнения
# с платным Topaz идут через Replicate. Сам сервер с 24.08 туда не ходит.
REPLICATE_API_TOKEN=r8_replace_with_your_replicate_api_token

# Нужен не сайту, а `yarn stats`: секция Google на доске журнала. Путь к JSON-ключу
# сервисного аккаунта. Заводится один раз: console.cloud.google.com → проект →
# включить «Google Search Console API» → IAM → Service accounts → создать →
# Keys → Add key → JSON. Потом адрес аккаунта (`…@….iam.gserviceaccount.com`)
# добавить пользователем ресурса `sc-domain:tessarum.com` в самой Search Console
# (Settings → Users and permissions, прав «Restricted» хватает) — без этого
# Google ответит 403. Ключ хранить вне репозитория. Без переменной доска
# собирается, секция Google говорит, что снимка нет.
# GOOGLE_SERVICE_ACCOUNT=/home/you/.config/tessarum/search-console.json
# Ключ IndexNow: им сайт сам рассказывает Bing'у о новых адресах при старте
# (`indexnow.js`). Google приходит сам, Bing — нет: за неделю он взял только
# `/robots.txt` и `/`, а карту сайта не прочёл ни разу. Поиск ChatGPT опирается
# на индекс Bing, поэтому цена молчания — помощник, знающий лишь парадную дверь.
#
# ЭТО НЕ СЕКРЕТ: тот же ключ лежит открытым текстом на `https://tessarum.com/<ключ>.txt`,
# и маршрут, который его отдаёт, заводится тут же. В переменной он затем, что
# она работает выключателем: не задана — не отправляется ничего и файла
# отправленного не заводится. Задавать её на машине разработчика незачем.
#
# Значение — 8–128 знаков из букв, цифр и дефиса; годится любое случайное,
# например `node -e "console.log(require('crypto').randomUUID().replace(/-/g,''))"`.
# INDEXNOW_KEY=

# Где лежит список уже отправленных адресов. Умолчание — `indexnow/` рядом
# с кодом; на боевой машине это том, переживающий пересборку, иначе каждый
# перезапуск слал бы Bing'у все адреса заново.
# INDEXNOW_DIR=indexnow

PORT=3000
HOST=0.0.0.0

# Есть ли перед сервером обратный прокси. Счётчик вызовов считает по адресу
# посетителя, а за прокси адрес у всех один — прокси. `1` — один прокси
# впереди, `loopback` — прокси на этой же машине. Пусто (умолчание) — прокси
# нет; включать наугад нельзя, иначе `X-Forwarded-For` подделает кто угодно.
# `true` понимается как `1`; на непонятное значение сервер не стартует
# и называет эту переменную.
# TRUST_PROXY=1

# Где лежат адреса из рассылки. Умолчание — `mail/` рядом с кодом; на боевой
# машине это том, переживающий пересборку. Отдельно от журнала (`LOG_DIR`)
# нарочно: журнал обещает, что личного в нём нет, — см. mailing.js.
# MAIL_DIR=mail

# Адрес сайта. Из него строятся canonical, og:url, карта сайта и ссылка
# на условия в разметке. Умолчание — боевой домен; для местной работы
# раскомментируйте строку ниже, иначе локальные страницы будут называть
# своим адресом tessarum.com.
# SITE_ORIGIN=http://127.0.0.1:3000
