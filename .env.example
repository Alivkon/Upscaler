# Create an API token at https://replicate.com/account/api-tokens and paste it here.
REPLICATE_API_TOKEN=r8_replace_with_your_replicate_api_token
PORT=3000
HOST=0.0.0.0

# Есть ли перед сервером обратный прокси. Счётчик вызовов считает по адресу
# посетителя, а за прокси адрес у всех один — прокси. `1` — один прокси
# впереди, `loopback` — прокси на этой же машине. Пусто (умолчание) — прокси
# нет; включать наугад нельзя, иначе `X-Forwarded-For` подделает кто угодно.
# `true` понимается как `1`; на непонятное значение сервер не стартует
# и называет эту переменную.
# TRUST_PROXY=1

# Адрес сайта. Из него строятся canonical, og:url, карта сайта и ссылка
# на условия в разметке. Умолчание — боевой домен; для местной работы
# раскомментируйте строку ниже, иначе локальные страницы будут называть
# своим адресом tessarum.com.
# SITE_ORIGIN=http://127.0.0.1:3000
